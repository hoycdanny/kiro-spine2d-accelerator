{
  "name": "kiro-spine2d-power",
  "version": "0.1.0",
  "description": "Kiro Power package for Spine 2D development — CLI orchestration, skeleton data inspection and linting, texture packing settings, PSD-to-rig generation, visual regression, and runtime integration.",
  "private": true,
  "bin": {
    "spine-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "demo": "node demo/run-demo.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:property": "jest --testPathPattern=tests/property",
    "test:integration": "jest --testPathPattern=tests/integration"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.7.5",
    "fast-check": "3.22.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@esotericsoftware/spine-webgl": "4.2.120",
    "playwright-core": "1.62.0"
  }
}
