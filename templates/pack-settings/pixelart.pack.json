{
  "stripWhitespaceX": false,
  "stripWhitespaceY": false,
  "rotation": false,
  "alias": true,
  "ignoreBlankImages": false,
  "alphaThreshold": 0,
  "paddingX": 1,
  "paddingY": 1,
  "edgePadding": true,
  "duplicatePadding": false,
  "minWidth": 16,
  "minHeight": 16,
  "maxWidth": 1024,
  "maxHeight": 1024,
  "pot": true,
  "multipleOfFour": false,
  "square": false,
  "filterMin": "Nearest",
  "filterMag": "Nearest",
  "wrapX": "ClampToEdge",
  "wrapY": "ClampToEdge",
  "format": "RGBA8888",
  "outputFormat": "png",
  "jpegQuality": 0.9,
  "packing": "rectangles",
  "premultiplyAlpha": false,
  "bleed": false,
  "bleedIterations": 2,
  "scale": [1],
  "scaleSuffix": [],
  "scaleResampling": ["nearest"],
  "atlasExtension": ".atlas",
  "combineSubdirectories": false,
  "flattenPaths": false,
  "useIndexes": true,
  "debug": false,
  "fast": false,
  "limitMemory": true,
  "currentProject": true,
  "silent": false,
  "ignore": false,
  "separator": "_"
}
